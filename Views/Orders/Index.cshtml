@model IEnumerable<OrderManagement.Models.Order>
@{
    ViewData["Title"] = "Order List";
}
<link rel="stylesheet" href="~/css/dm.css" asp-append-version="true" />

<div class="container">
    <h2>
        Order Management
        <a asp-action="Create" class="btn btn-primary">Add New Order</a>
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert">@TempData["Success"]</div>
    }

    <form asp-action="Index" method="get" class="search-container" style="display: flex; gap: 10px; margin-bottom: 20px;">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="max-width: 350px;" placeholder="Search by Order No or Customer..." />
        <button type="submit" class="btn btn-primary" style="margin-bottom:0">Search</button>
        <a asp-action="Index" class="btn btn-warning" style="min-width:auto; background-color: #6c757d;">Reset</a>
    </form>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Order Number</th>
                    <th>Customer Name</th>
                    <th>Customer Email</th> @* Thêm mới *@
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Order Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int index = (ViewBag.CurrentPage - 1) * 10 + 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(index++)</td>
                        <td><code>@item.OrderNumber</code></td>
                        <td><strong>@item.CustomerName</strong></td>
                        <td>@item.CustomerEmail</td> @* Thêm mới *@
                        <td>@item.Product?.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span class="badge @(item.DeliveryDate.HasValue ? "badge-delivered" : "badge-pending")">
                                @(item.DeliveryDate.HasValue ? "Delivered" : "Pending")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Hiển thị thông tin phân trang và tổng số bản ghi *@
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px;">
        <p class="text-muted">Total records: <strong>@ViewBag.TotalItems</strong></p>
        @if (ViewBag.TotalPages > 1)
        {
            <ul class="pagination" style="margin: 0;">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }
            </ul>
        }
    </div>
</div>